generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectRole {
  OWNER
  MEMBER
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum UserRole {
  USER
  ADMIN
}

enum MemoryScope {
  USER
  PROJECT
}

model User {
  id                   String          @id @default(uuid()) @db.Uuid
  email                String          @unique
  passwordHash         String?
  name                 String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  role                 UserRole        @default(USER)
  createdProjects      Project[]       @relation("ProjectCreator")
  memberships          ProjectMember[]
  createdConversations Conversation[]  @relation("ConversationCreator")
  googleConnection     GoogleConnection?
  createdMemories      AgentMemory[]    @relation("MemoryCreator")
}

model GoogleConnection {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @db.Uuid
  googleSubject         String   @unique
  email                 String
  accessTokenEncrypted  String   @db.Text
  refreshTokenEncrypted String?  @db.Text
  scopes                String[]
  expiresAt             DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
}

model AIModel {
  id        String   @id
  name      String
  provider  String
  enabled   Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id              String          @id @default(uuid()) @db.Uuid
  name            String
  slug            String          @unique
  createdByUserId String          @db.Uuid
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdBy       User            @relation("ProjectCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  members         ProjectMember[]
  conversations   Conversation[]
  memories        AgentMemory[]
}

model ProjectMember {
  projectId String      @db.Uuid
  userId    String      @db.Uuid
  role      ProjectRole
  createdAt DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([projectId, userId])
  @@index([userId, projectId])
}

model Conversation {
  id              String    @id @default(uuid()) @db.Uuid
  projectId       String    @db.Uuid
  createdByUserId String    @db.Uuid
  title           String?
  modelId         String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User      @relation("ConversationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  messages        Message[]

  @@index([projectId, createdByUserId, updatedAt])
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @db.Uuid
  role           MessageRole
  content        String
  modelId        String?
  metadata       Json?
  createdAt      DateTime    @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sourcedMemories AgentMemory[]

  @@index([conversationId, createdAt])
}

model AgentSoul {
  id             String   @id
  name           String
  role           String
  personality    String   @db.Text
  companyContext String   @db.Text
  instructions   String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AgentMemory {
  id                String      @id @default(uuid()) @db.Uuid
  scope             MemoryScope
  key               String
  content           String      @db.Text
  kind              String
  confidence        Float       @default(1)
  createdByUserId   String      @db.Uuid
  projectId         String?     @db.Uuid
  sourceMessageId   String?     @db.Uuid
  archived          Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  lastAccessedAt    DateTime?
  createdBy         User        @relation("MemoryCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  project           Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceMessage     Message?    @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)

  @@index([createdByUserId, scope, archived, updatedAt])
  @@index([projectId, scope, archived, updatedAt])
  @@index([sourceMessageId])
}
