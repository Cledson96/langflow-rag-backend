generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectRole {
  OWNER
  MEMBER
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

model User {
  id                   String          @id @default(uuid()) @db.Uuid
  email                String          @unique
  passwordHash         String
  name                 String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  createdProjects      Project[]       @relation("ProjectCreator")
  memberships          ProjectMember[]
  createdConversations Conversation[]  @relation("ConversationCreator")
}

model Project {
  id              String          @id @default(uuid()) @db.Uuid
  name            String
  slug            String          @unique
  createdByUserId String          @db.Uuid
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdBy       User            @relation("ProjectCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  members         ProjectMember[]
  conversations   Conversation[]
}

model ProjectMember {
  projectId String      @db.Uuid
  userId    String      @db.Uuid
  role      ProjectRole
  createdAt DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([projectId, userId])
  @@index([userId, projectId])
}

model Conversation {
  id              String    @id @default(uuid()) @db.Uuid
  projectId       String    @db.Uuid
  createdByUserId String    @db.Uuid
  title           String?
  modelId         String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User      @relation("ConversationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  messages        Message[]

  @@index([projectId, createdByUserId, updatedAt])
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @db.Uuid
  role           MessageRole
  content        String
  modelId        String?
  metadata       Json?
  createdAt      DateTime    @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
