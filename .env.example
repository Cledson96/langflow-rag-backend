NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://app:replace-with-password@db:5432/app
JWT_SECRET=replace-with-a-secret-at-least-24-characters-long
JWT_EXPIRES_IN=1h
LANGFLOW_BASE_URL=http://langflow:7860
LANGFLOW_FLOW_ID=replace-with-flow-id
LANGFLOW_API_KEY=replace-with-langflow-service-key
OPENROUTER_ALLOWED_MODELS=openai/gpt-4.1-mini
