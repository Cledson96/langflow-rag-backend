NODE_ENV=production
PORT=3000
CORS_ORIGINS=https://app.example.com
DATABASE_URL=postgresql://app:inject-from-secret@db:5432/app
JWT_SECRET=inject-from-a-secret-store
JWT_EXPIRES_IN=1h
ADMIN_EMAILS=admin@example.com
FRONTEND_URL=https://app.example.com
GOOGLE_CLIENT_ID=inject-from-github-secret
GOOGLE_CLIENT_SECRET=inject-from-github-secret
GOOGLE_REDIRECT_URI=https://api.example.com/integrations/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=inject-64-hex-characters-from-github-secret
LANGFLOW_BASE_URL=http://langflow:7860
LANGFLOW_FLOW_ID=inject-from-github-variable
LANGFLOW_API_KEY=inject-from-github-secret
OPENROUTER_ALLOWED_MODELS=openai/gpt-4.1-mini
OPENROUTER_API_KEY=inject-from-github-secret
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
